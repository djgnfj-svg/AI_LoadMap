# Supabase 프로젝트 > Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roadmap_planner

# 비워두면 목업 Planner 로 돈다. 그래프·critic·진단·재설계는 그대로 동작하고
# LLM 호출만 결정적 목업으로 바뀐다. 실제 Claude 를 쓰려면 키를 넣는다.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# 키가 있어도 목업으로 돌리고 싶을 때 true
USE_MOCK_PLANNER=false

# SPEC §3.3 critic 재시도 상한
CRITIC_MAX_RETRIES=3

# 구글 로그인. 비워두면 데모 계정 로그인으로 대신한다 (목업 Planner 와 같은 결).
# 켜려면 Google Cloud > API 및 서비스 > 사용자 인증 정보에서 「OAuth 클라이언트 ID」를
# 웹 애플리케이션으로 만들고, 승인된 JavaScript 원본에 http://localhost:5173 을 넣는다.
# ⚠ 값이 들어오는 순간 데모 로그인 문은 닫힌다.
GOOGLE_CLIENT_ID=
# 세션 쿠키 서명 키. 비워두면 뜰 때마다 새로 만들어서, 재시작하면 로그인이 풀린다.
# 배포할 때는 반드시 채운다: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# https 로 서비스할 때만 true. 로컬 http 에서 켜면 쿠키가 아예 안 실린다.
SESSION_COOKIE_SECURE=false

# 데모 계정 (0004 마이그레이션이 이 id 로 실제 행을 넣는다)
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

SCHEDULER_ENABLED=true
CORS_ORIGINS=http://localhost:5173
