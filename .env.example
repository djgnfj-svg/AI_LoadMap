# Supabase 프로젝트 > Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roadmap_planner

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5

# API 키 없이 돌리기. 생성·재설계 그래프는 그대로 돌고 LLM 만 목업으로 바뀐다.
# 키가 비어 있으면 자동으로 목업이 된다.
USE_MOCK_PLANNER=false

# SPEC §3.3 critic 재시도 상한
CRITIC_MAX_RETRIES=3

# SPEC §0.3 — v1 은 로그인 대신 데모 계정 고정
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

SCHEDULER_ENABLED=true
CORS_ORIGINS=http://localhost:5173
